<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Muzzlebook</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link href="~/lib/box/css/box.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/font-awesome/css/all.min.css" />
    @await RenderSectionAsync("Styles", required: false)
    @* <link rel="stylesheet" href="~/Muzzlebook.styles.css" asp-append-version="true" /> *@
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-page="/Index">Muzzlebook</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-page="/Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-page="/Breeds">Razze</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - Muzzlebook - <a asp-area="" asp-page="/Privacy">Privacy</a>
        </div>
    </footer>

    @* <script src="~/lib/jquery/dist/jquery.min.js"></script> *@
    <script src="~/lib/box/js/box.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
     <script src="~/lib/htmx/htmx.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
            // Aggiunge un header custom a ogni richiesta HTMX.
            // Lato server (PageHandler) permette di distinguere chiamate HTMX da normali richieste browser:
            //if (Request.Headers["X-Requested-With"] == "HTMX") { return Partial(...) } else { return Page() }
            document.body.addEventListener('htmx:configRequest', function (evt) {
                evt.detail.headers['X-Requested-With'] = 'HTMX';
            });
    </script>
    <script>
        //gestione della sessione
            let timeoutSessione;
            const DURATA_INATTIVITA = 15 * 60 * 1000; // 15 minuti in millisecondi

            // Rende la funzione globale, così puoi chiamarla anche a mano se necessario
            window.resetTimerSessione = function() {
                clearTimeout(timeoutSessione);
                timeoutSessione = setTimeout(() => {
                    window.location.href = 'index?handler=Logout';
                }, DURATA_INATTIVITA);
            };

            // 1. Avvia il timer al primo caricamento della pagina
            window.resetTimerSessione();

            // 2. Resetta il timer ad ogni chiamata HTMX (se usata)
            document.body.addEventListener('htmx:beforeRequest', window.resetTimerSessione);

            // 3. Resetta il timer ad ogni chiamata fetch() nativa
            const originalFetch = window.fetch;
            window.fetch = async function(...args) {
                window.resetTimerSessione();
                return await originalFetch.apply(this, args);
            };

            // 4. Resetta il timer ad ogni click dell'utente sulla pagina
            // (Consigliato: copre i casi in cui l'utente interagisce senza fare fetch)
            document.addEventListener('click', window.resetTimerSessione);
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
