@using System.Security.Claims;
@{
    string IdUtente = User.FindFirstValue(ClaimTypes.NameIdentifier) ?? string.Empty;
    string loginLabel = (string.IsNullOrEmpty(IdUtente)) ? "Login" : "Logout";
    string unLogin = (string.IsNullOrEmpty(IdUtente)) ? "<i title=\"Devi autenticarti per accedere a questa area\" class=\"fa-solid fa-lock\"></i>" : "";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- PWA Meta Tags -->
    <link rel="manifest" href="~/manifest.json" />
    <meta name="theme-color" content="#1b6ec2" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <link rel="apple-touch-icon" href="~/images/icon-512.png" />
    <title>@ViewData["Title"] - Muzzlebook</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link href="~/lib/box/css/box.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/font-awesome/css/all.min.css" />
    @await RenderSectionAsync("Styles", required: false)
   
</head>
<body>
<header class="sticky-top">
    <nav class="navbar navbar-expand-sm navbar-dark bg-primary shadow-sm mb-4  rounded-bottom-4">
        <div class="container-fluid">
            <!-- Logo e Brand -->
            <a class="navbar-brand d-flex align-items-center gap-2 fw-bold me-4" asp-area="" asp-page="/Index">
                <div class="bg-white p-1 rounded-circle border border-danger d-flex align-items-center justify-content-center shadow-sm" style="width: 44px; height: 44px;">
                    <img src="~/images/logo.png" alt="Logo" width="36" height="36" class="img-fluid rounded-circle" />
                </div>
                <div class="position-relative">
                    <span class="fs-4">Muzzlebook</span>
                    <div style="font-size: 0.5em;">Il libro dei musi</div>
                </div>
            </a>
            <!-- Pulsante Installa PWA (nascosto di default) -->
            <button id="pwa-install-btn" type="button" class="btn btn-light btn-sm ms-auto me-2 d-none">
                <i class="bi bi-download me-1"></i> Installa App
            </button>
            <!-- Toggler per Mobile -->
            <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                    aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <!-- Navigazione -->
            <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                <ul class="navbar-nav flex-grow-1 gap-1">
                    <li class="nav-item">
                        <a class="nav-link text-white fw-semibold" asp-area="" asp-page="/Index">
                            <i class="bi bi-house-door-fill me-1"></i>Home
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-white-50 fw-semibold" asp-area="" asp-page="/musi">
                            <i class="bi bi-journal-bookmark-fill me-1"></i>I miei Musi @Html.Raw(unLogin)
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-white-50 fw-semibold" asp-area="" asp-page="/test">
                            <i class="bi bi-journal-bookmark-fill me-1"></i>TestDB
                        </a>
                    </li>
                    <li class="nav-item">   
                        <a class="nav-link text-white-50 fw-semibold" asp-area="" asp-page="/Breeds">
                            <i class="bi bi-journal-bookmark-fill me-1"></i>Razze
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-white-50 fw-semibold" asp-area="" asp-page="/Index" asp-page-handler="Logout">
                            <i class="bi bi-journal-bookmark-fill me-1"></i>@loginLabel
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>
</header>
    <div class="container-fluid">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - Muzzlebook - <a asp-area="" asp-page="/Privacy">Privacy</a>
        </div>
    </footer>

    @* <script src="~/lib/jquery/dist/jquery.min.js"></script> *@
    <script src="~/lib/box/js/box.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
     <script src="~/lib/htmx/htmx.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
            if ('serviceWorker' in navigator) {
                window.addEventListener('load', () => {
                    navigator.serviceWorker.register('/sw.js')
                        .then(reg => console.log('Service Worker registrato con successo:', reg.scope))
                        .catch(err => console.error('Errore registrazione Service Worker:', err));
                });
            }
    </script>
    <script>
            // Aggiunge un header custom a ogni richiesta HTMX.
            // Lato server (PageHandler) permette di distinguere chiamate HTMX da normali richieste browser:
            //if (Request.Headers["X-Requested-With"] == "HTMX") { return Partial(...) } else { return Page() }
            document.body.addEventListener('htmx:configRequest', function (evt) {
                evt.detail.headers['X-Requested-With'] = 'HTMX';
            });
    </script>
    <script>
        //gestione della sessione
            // let timeoutSessione;
