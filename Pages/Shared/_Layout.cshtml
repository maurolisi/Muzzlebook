@using System.Security.Claims;
@{
    string IdUtente = User.FindFirstValue(ClaimTypes.NameIdentifier) ?? string.Empty;
    string loginLabel = (string.IsNullOrEmpty(IdUtente)) ? "Login" : "Logout";
string unLogin = (string.IsNullOrEmpty(IdUtente)) ? "<i title='Devi autenticarti per accedere a questa area' class='fa-solid fa-lock me-1'></i>" : "<i class='bi bi-journal-bookmark-fill me-1'></i>";
    string IsActive(string page) =>
        string.Equals(ViewContext.RouteData.Values["page"]?.ToString(), page, StringComparison.OrdinalIgnoreCase)
            ? "text-white active"
            : "text-white-50";
}
