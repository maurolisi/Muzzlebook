  <script>
// Gestione del tracciamento della posizione globale
let trackingInterval = null;
let invioInCorso = false;

function avviaTracciamento() {
    if (trackingInterval) return; // evita doppi intervalli
    inviaPosizioneGlobale();
    trackingInterval = setInterval(inviaPosizioneGlobale, 60000);
    aggiornaPosizioni();
}

function fermaTracciamento() {
    if (trackingInterval) {
        clearInterval(trackingInterval);
        trackingInterval = null;
    }
}
function inviaPosizioneGlobale() {
    if (!navigator.geolocation || invioInCorso) return;
    invioInCorso = true;

    const successo = async (pos) => {
        try {
            const token = document.querySelector('meta[name="csrf-token"]')?.content;
            const res = await fetch("/TrackPosition", {
                method: "POST",
                headers: {
                    "Content-Type": "application/json",
                    "RequestVerificationToken": token
                },
                body: JSON.stringify({
                    latitude: pos.coords.latitude,
                    longitude: pos.coords.longitude
                })
            });
            if (!res.ok) console.error("TrackPosition ha risposto", res.status);
        } catch (error) {
            console.error("Errore invio posizione background:", error);
        } finally {
            invioInCorso = false;
        }
    };

    const fallimentoFinale = (err) => {
        console.warn("Errore GPS background:", err.code, err.message);
        invioInCorso = false;
    };

    // 1° tentativo: alta precisione (GPS), timeout breve
    navigator.geolocation.getCurrentPosition(
        successo,
        () => {
            // 2° tentativo: precisione bassa (Wi-Fi/IP), molto più veloce
            navigator.geolocation.getCurrentPosition(
                successo,
                fallimentoFinale,
                { enableHighAccuracy: false, timeout: 15000, maximumAge: 60000 }
            );
        },
        { enableHighAccuracy: true, timeout: 5000, maximumAge: 5000 }
    );
}
 async function aggiornaPosizioni() {
        try {
            const response = await fetch("?handler=PosizioniAttive");
            if (!response.ok) throw new Error("Errore rete");

            const cani = await response.json();
            const currentDogIds = new Set();
            const coordinateOccupate = {};

            cani.forEach(cane => {
                currentDogIds.add(cane.dogId);

                let lat = cane.latitude;
                let lng = cane.longitude;

                // Evita sovrapposizioni (~2 metri)
                const coordKey = `${lat.toFixed(5)}_${lng.toFixed(5)}`;
                if (coordinateOccupate[coordKey] !== undefined) {
                    coordinateOccupate[coordKey]++;
                    const offset = coordinateOccupate[coordKey] * 0.00002;
                    lat += offset;
                    lng += offset;
                } else {
                    coordinateOccupate[coordKey] = 0;
                }

                const oraFormat = new Date(cane.timestamp)
                    .toLocaleTimeString('it-IT', { hour: '2-digit', minute: '2-digit' });

                const iconUrl = cane.profileImageUrl
                    ? "https://media.muzzlebook.it" + cane.profileImageUrl
                    : "/images/logo.png";

                const nuovaPosizione = { lat, lng };
                const esistente = activeMarkers[cane.dogId];

                if (esistente) {
                    esistente.position = nuovaPosizione;
                    esistente._ora = oraFormat;
                    return;
                }

                const contentDiv = document.createElement('div');
                contentDiv.className = 'dog-marker-container';
                const img = document.createElement('img');
                img.src = iconUrl;
                img.alt = cane.name;
                img.className = 'dog-avatar-pin';
                contentDiv.appendChild(img);

                const marker = new AdvancedMarkerElement({
                    map: map,
                    position: nuovaPosizione,
                    title: cane.name,
                    content: contentDiv,
                    gmpClickable: true
                });
                marker._ora = oraFormat;

                marker.addListener('click', () => {
                    const box = document.createElement('div');
                    box.className = 'text-center p-2';
                    box.innerHTML = `
                        <strong class="fs-6 d-block text-primary"></strong>
                        <span class="small text-muted"><i class="bi bi-clock me-1"></i>Visto alle <span class="ora"></span></span>`;
                    box.querySelector('strong').textContent = cane.name;
                    box.querySelector('.ora').textContent = marker._ora;

                    infoWindow.setContent(box);
                    infoWindow.open({ anchor: marker, map: map });
                });

                activeMarkers[cane.dogId] = marker;
            });

            // Rimuove i marker scaduti
            for (const dogId in activeMarkers) {
                if (!currentDogIds.has(parseInt(dogId))) {
                    activeMarkers[dogId].map = null;
                    delete activeMarkers[dogId];
                }
            }
        } catch (error) {
            console.error("Errore fetch posizioni:", error);
        }
    }
</script>

<script>
// gestione schermo acceso (Wake Lock API) per evitare che il browser metta in pausa la geolocalizzazione quando la pagina va in background 
let wakeLock = null;

async function richiediWakeLock() {
    if (!('wakeLock' in navigator)) {
        console.warn("Wake Lock non supportato da questo browser.");
        return;
    }
    if (wakeLock || document.visibilityState !== 'visible') return;

    try {
        wakeLock = await navigator.wakeLock.request('screen');
        wakeLock.addEventListener('release', () => { wakeLock = null; });
    } catch (err) {
        // Può fallire con risparmio energetico attivo o senza interazione utente
        console.warn("Wake Lock non ottenuto:", err.name, err.message);
    }
}

// All'avvio
richiediWakeLock();

// Il browser rilascia il lock quando la pagina va in background: va richiesto di nuovo
document.addEventListener('visibilitychange', () => {
    if (document.visibilityState === 'visible') richiediWakeLock();
});

// Rete di sicurezza: se la richiesta iniziale è stata rifiutata,
// riprova al primo tocco dell'utente
['click', 'touchstart'].forEach(evento =>
    document.addEventListener(evento, richiediWakeLock, { once: true, passive: true })
);



//fissa posizione
// Funzione globale richiamabile da qualsiasi pagina
window.gestisciPosizioneFissa = async function(fissa) {
    // Evita click multipli accidentali durante l'elaborazione
    if (window.fissaggioInCorso) return;
    window.fissaggioInCorso = true;

    // 1. Gestione Session Storage
    if (fissa) {
        sessionStorage.setItem('posizioneFissaAttiva', 'true');
    } else {
        sessionStorage.removeItem('posizioneFissaAttiva');
    }

    let lat = 0;
    let lng = 0;

    // 2. Lettura GPS con strategia a due tentativi (High -> Low)
    if (fissa) {
        if (!navigator.geolocation) {
            if (typeof box !== 'undefined' && box.alert) box.alert("La geolocalizzazione non è supportata.");
            window.fissaggioInCorso = false;
            return;
        }

        try {
            const position = await new Promise((resolve, reject) => {
                // Funzione di fallback: 2° tentativo (bassa precisione, per PC e Wi-Fi)
                const fallback = (err) => {
                    console.warn("GPS alta precisione fallito, tento con rete/IP:", err.message);
                    navigator.geolocation.getCurrentPosition(
                        resolve, 
                        reject, // Fallimento finale
                        { enableHighAccuracy: false, timeout: 15000, maximumAge: 60000 }
                    );
                };

                // 1° tentativo: cerca il chip GPS (smartphone)
                navigator.geolocation.getCurrentPosition(
                    resolve, 
                    fallback, 
                    { enableHighAccuracy: true, timeout: 5000, maximumAge: 5000 }
                );
            });

            lat = position.coords.latitude;
            lng = position.coords.longitude;
            
        } catch (error) {
            console.warn("Errore GPS definitivo:", error.message);
            if (typeof box !== 'undefined' && box.alert) box.alert("Impossibile recuperare la posizione. Controlla i permessi.");
            window.fissaggioInCorso = false;
            return;
        }
    }

    // 3. Invio al server
    const tokenElement = document.querySelector('input[name="__RequestVerificationToken"]');
    const token = tokenElement ? tokenElement.value : "";

    try {
        const response = await fetch("/TrackPosition?handler=FissaPosizione", {
            method: "POST",
            headers: {
                "Content-Type": "application/json",
                "RequestVerificationToken": token
            },
            body: JSON.stringify({ 
                latitude: lat, 
                longitude: lng, 
                fissa: fissa 
            })
        });

        if (response.ok) {
            if (typeof box !== 'undefined' && box.toast) {
                box.toast(fissa ? "Posizione fissa registrata!" : "Posizione sbloccata.", fissa ? "success" : "warning");
            }
            
            // Aggiorna la visibilità dell'icona nella navbar
            const navIcon = document.getElementById('nav-fissa-icon');
            if (navIcon) {
                if (fissa) navIcon.classList.remove('d-none');
                else navIcon.classList.add('d-none');
            }
        } else {
            console.error("Errore server durante il salvataggio.");
        }
    } catch (error) {
        console.error("Errore di rete:", error);
    } finally {
        // Sblocca la funzione per click successivi
        window.fissaggioInCorso = false;
        ckFissa();
        aggiornaPosizioni();
    }
};
</script>
    @await RenderSectionAsync("Scripts", required: false)
