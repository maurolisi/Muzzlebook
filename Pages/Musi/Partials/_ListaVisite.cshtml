@model IEnumerable<Muzzlebook.Models.DTOs.MedicalVisitDto>

@if (!Model.Any())
{
    <p class="text-muted mb-0">Nessuna visita medica registrata.</p>
}
else
{
    <ul class="list-group list-group-flush rounded shadow-sm">
        @foreach (var item in Model)
        {
            <li class="list-group-item bg-white p-3">
                <strong>@item.ReasonForVisit</strong> <br />
                <small class="text-muted">
                    <i class="bi bi-calendar-event me-1"></i>Data: @(item.VisitDate?.ToString("dd/MM/yyyy") ?? "-")
                </small>
            </li>
        }
    </ul>
}