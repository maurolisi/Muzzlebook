@model IEnumerable<Muzzlebook.Models.DTOs.ClinicalDocumentDto>

@if (!Model.Any())
{
    <p class="text-muted mb-0">Nessun documento clinico caricato.</p>
}
else
{
    <ul class="list-group list-group-flush rounded shadow-sm">
        @foreach (var item in Model)
        {
            <li class="list-group-item bg-white p-3">
                <a href="#" target="_blank" class="fw-bold text-decoration-none">
                    <i class="bi bi-download me-2"></i>@item.Title
                </a> <br />
                <small class="text-muted">@item.DocumentType</small>
            </li>
        }
    </ul>
}