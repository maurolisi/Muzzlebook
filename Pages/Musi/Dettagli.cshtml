@page "{id:int?}"
@model Muzzlebook.Pages.Musi.DettagliModel
@{
    ViewData["Title"] = $"Dettagli di {Model.CurrentDog.Name}";

    // Gestione dell'URL immagine (R2 o default)
    string urlImage = string.IsNullOrEmpty(Model.CurrentDog.ProfileImageUrl)
        ? "/images/logo.png"
        : "https://media.muzzlebook.it" + Model.CurrentDog.ProfileImageUrl;
}
@Html.AntiForgeryToken()
<div class="container my-4">
    <!-- Intestazione con pulsante Indietro -->
    <div class="d-flex align-items-center mb-4 pb-2 border-bottom">
        <a asp-page="/Musi/Index" class="btn btn-outline-secondary rounded-pill me-3 shadow-sm">
            <i class="bi bi-arrow-left"></i> Indietro
        </a>
        <h2 class="fw-bold text-primary mb-0">
            <i class="fa-solid fa-book-open text-danger me-2"></i>Dettagli di @Model.CurrentDog.Name
        </h2>
    </div>

    <div class="row g-4">
        <!-- Colonna Sinistra: Card Foto e Taglia/Sesso -->
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 text-center overflow-hidden h-100">
                <div class="bg-primary-subtle bg-gradient p-4 border-bottom d-flex justify-content-center position-relative">
                    <button type="button"
                            onclick="openProfileImage(@Model.CurrentDog.Id)"
                            class="btn btn-primary btn-sm rounded-circle position-absolute shadow border border-2 border-white d-flex align-items-center justify-content-center btn-camera"
                            style="width: 45px; height: 45px; right: 8.3em; bottom: 1em;"
                            title="Gestisci foto profilo">
                        <i class="fa-solid fa-pen-to-square text-white" style="font-size: 1.8em;"></i>
                    </button> 
                    <img src="@urlImage"
                        title="Gestisci Immagine Profilo"
                         onclick="openProfileImage(@Model.CurrentDog.Id)"
                         id="dogImg_@Model.CurrentDog.Id"
                         alt="@Model.CurrentDog.Name"
                         class="rounded-circle border border-4 border-white shadow c-p"
                         style="width: 160px; height: 160px; object-fit: cover;" />
                </div>
                <div class="card-body">
                    <h3 class="fw-bold mb-1">@Model.CurrentDog.Name</h3>

                    @if (!string.IsNullOrEmpty(Model.CurrentDog.Breed))
                    {
                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill mb-3 px-3 fw-semibold">
                            @Model.CurrentDog.Breed
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-warning-subtle text-dark border border-warning-subtle rounded-pill mb-3 px-3 fw-semibold">
                            Meticcio
                        </span>
                    }

                    <div class="d-flex justify-content-center gap-2 mt-2">
                        @if (!string.IsNullOrEmpty(Model.CurrentDog.Gender))
                        {
                            <span class="badge @(Model.CurrentDog.Gender == "M" ? "bg-primary" : "bg-danger") px-3 py-2 fs-6 rounded-pill">
                                <i class="bi @(Model.CurrentDog.Gender == "M" ? "bi-gender-male" : "bi-gender-female") me-1"></i>
                                @(Model.CurrentDog.Gender == "M" ? "Maschio" : "Femmina")
                            </span>
                        }
                        @if (Model.CurrentDog.CurrentWeightKg.HasValue && Model.CurrentDog.CurrentWeightKg > 0)
                        {
                            <span class="badge bg-info text-dark px-3 py-2 fs-6 rounded-pill">
                                <i class="bi bi-speedometer2 me-1"></i>@Model.CurrentDog.CurrentWeightKg kg
                            </span>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Colonna Destra: Informazioni Anagrafiche -->
        <div class="col-md-8">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-header bg-white border-bottom py-3">
                    <h5 class="mb-0 fw-bold"><i class="bi bi-card-list text-primary me-2"></i>Scheda Anagrafica</h5>
                </div>
                <div class="card-body p-0">
                    <ul class="list-group list-group-flush">
                        <li class="list-group-item d-flex justify-content-between align-items-center p-4">
                            <div><i class="bi bi-calendar3 text-muted me-2 fs-5"></i><strong>Data di Nascita</strong></div>
                            <span class="fs-6">@(Model.CurrentDog.DateOfBirth?.ToString("dd/MM/yyyy") ?? "Non specificata")</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center p-4">
                            <div><i class="bi bi-upc-scan text-muted me-2 fs-5"></i><strong>Microchip</strong></div>
                            <span class="fs-6">@(string.IsNullOrEmpty(Model.CurrentDog.Microchip) ? "Non inserito" : Model.CurrentDog.Microchip)</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center p-4">
                            <div><i class="bi bi-clock-history text-muted me-2 fs-5"></i><strong>Aggiunto il</strong></div>
                            <span class="fs-6 text-muted">@Model.CurrentDog.CreatedAt.ToString("dd/MM/yyyy")</span>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>

<!-- Nuova Sezione: Media del Muso -->
    <div class="mt-5">
        <!-- Bottone per espandere/richiudere i media -->
        <button class="btn btn-light w-100 text-start d-flex justify-content-between align-items-center p-3 shadow-sm rounded-4 mb-3 border-0" 
                type="button" data-bs-toggle="collapse" data-bs-target="#wrapperMedia" aria-expanded="false" aria-controls="wrapperMedia">
            <h4 class="fw-bold mb-0 text-dark"><i class="bi bi-images text-success me-2"></i>Media del muso</h4>
            <i class="bi bi-chevron-expand fs-4 text-muted"></i>
        </button>
        
        <!-- Wrapper Collapse per la Galleria -->
        <div class="collapse" id="wrapperMedia">
            <div class="d-flex justify-content-end mb-3">
                <button class="btn btn-outline-primary rounded-pill shadow-sm" onclick="document.getElementById('uploadMediaInput').click()">
                    <i class="bi bi-cloud-arrow-up me-1"></i> Aggiungi Foto/Video
                </button>
                <input type="file" id="uploadMediaInput" class="d-none" accept="image/*,video/*" onchange="uploadDogMedia(@Model.CurrentDog.Id, this)" />
            </div>
            
            <!-- Galleria Media -->
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-light">
                <div class="row g-3" id="dogMediaGallery">
                    @if (Model.DogMedia == null || !Model.DogMedia.Any())
                    {
                        <!-- Messaggio per galleria vuota -->
                        <div class="col-12 text-center text-muted py-4" id="emptyMediaMessage">
                            <i class="bi bi-camera fs-1 d-block mb-2 opacity-50"></i>
                            Nessuna foto o video. Condividi un momento speciale del tuo muso!
                        </div>
                    }
                    else
                    {
                        foreach (var media in Model.DogMedia)
                        {
                            var realUrl = "https://media.muzzlebook.it" + media.WebLink;
                            bool isVideo = media.ContentType?.ToLower() == "video" || media.MimeTipe?.StartsWith("video/") == true;

                            <div class="col-6 col-md-3" id="mediaBox_@media.IdMedia">
                                <div class="position-relative rounded-3 overflow-hidden shadow-sm ratio ratio-1x1 border bg-dark">
                                    <!-- Pulsante di eliminazione sovrimpresso -->
                                    <button class="btn btn-sm btn-danger position-absolute top-0 end-0 m-1 rounded-circle z-3 shadow" 
                                            onclick="deleteDogMedia(@media.IdMedia)" title="Rimuovi"
                                            style="width: 35px; height: 35px;">
                                        <i class="fa-solid fa-trash-can"></i>
                                    </button>
                                    
                                    @if (isVideo)
                                    {
                                        <video src="@realUrl" class="object-fit-contain w-100 h-100" controls></video>
                                    }
                                    else
                                    {
                                        <a href="@realUrl" target="_blank">
                                            <img src="@realUrl" class="object-fit-cover w-100 h-100" alt="@media.OriginalName" />
                                        </a>
                                    }
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Sezione: Accordion Fascicolo Sanitario -->
    <div class="mt-5">
        <!-- Bottone per espandere/richiudere tutto il fascicolo -->
        <button class="btn btn-light w-100 text-start d-flex justify-content-between align-items-center p-3 shadow-sm rounded-4 mb-3 border-0" 
                type="button" data-bs-toggle="collapse" data-bs-target="#wrapperFascicolo" aria-expanded="false" aria-controls="wrapperFascicolo">
            <h4 class="fw-bold mb-0 text-dark"><i class="bi bi-folder2-open text-primary me-2"></i>Fascicolo Sanitario</h4>
            <i class="bi bi-chevron-expand fs-4 text-muted"></i>
        </button>
        
        <!-- Wrapper Collapse per il Fascicolo -->
        <div class="collapse" id="wrapperFascicolo">
            <div class="accordion shadow-sm rounded-4 overflow-hidden" id="accordionFascicolo">
                
                <!-- 1. Vaccinazioni -->
                <div class="accordion-item border-0 border-bottom">
                    <h2 class="accordion-header" id="headingVaccinazioni">
                        <button class="accordion-button collapsed fw-bold" type="button" data-bs-toggle="collapse" data-bs-target="#collapseVaccinazioni" aria-expanded="false" aria-controls="collapseVaccinazioni">
                            <i class="bi bi-syringe text-success me-2 fs-5"></i> Vaccinazioni
                        </button>
                    </h2>
                    <div id="collapseVaccinazioni" class="accordion-collapse collapse" data-section="vaccinazioni" aria-labelledby="headingVaccinazioni" data-bs-parent="#accordionFascicolo">
                        <div class="accordion-body bg-light">
                            <div class="contenitore-dati text-muted mb-0">Clicca per caricare i dati...</div>
                        </div>
                    </div>
                </div>

                <!-- 2. Trattamenti Parassitari -->
                <div class="accordion-item border-0 border-bottom">
                    <h2 class="accordion-header" id="headingParassitari">
                        <button class="accordion-button collapsed fw-bold" type="button" data-bs-toggle="collapse" data-bs-target="#collapseParassitari" aria-expanded="false" aria-controls="collapseParassitari">
                            <i class="bi bi-bug text-warning me-2 fs-5"></i> Trattamenti Parassitari
                        </button>
                    </h2>
                    <div id="collapseParassitari" class="accordion-collapse collapse" data-section="parassitari" aria-labelledby="headingParassitari" data-bs-parent="#accordionFascicolo">
                        <div class="accordion-body bg-light">
                            <div class="contenitore-dati text-muted mb-0">Clicca per caricare i dati...</div>
                        </div>
                    </div>
                </div>

                <!-- 3. Visite Mediche -->
                <div class="accordion-item border-0 border-bottom">
                    <h2 class="accordion-header" id="headingVisite">
                        <button class="accordion-button collapsed fw-bold" type="button" data-bs-toggle="collapse" data-bs-target="#collapseVisite" aria-expanded="false" aria-controls="collapseVisite">
                            <i class="bi bi-heart-pulse text-danger me-2 fs-5"></i> Visite Mediche
                        </button>
                    </h2>
                    <div id="collapseVisite" class="accordion-collapse collapse" data-section="visite" aria-labelledby="headingVisite" data-bs-parent="#accordionFascicolo">
                        <div class="accordion-body bg-light">
                            <div class="contenitore-dati text-muted mb-0">Clicca per caricare i dati...</div>
                        </div>
                    </div>
                </div>

                <!-- 4. Documenti Clinici -->
                <div class="accordion-item border-0">
                    <h2 class="accordion-header" id="headingDocumenti">
                        <button class="accordion-button collapsed fw-bold" type="button" data-bs-toggle="collapse" data-bs-target="#collapseDocumenti" aria-expanded="false" aria-controls="collapseDocumenti">
                            <i class="bi bi-file-earmark-medical text-info me-2 fs-5"></i> Documenti Clinici
                        </button>
                    </h2>
                    <div id="collapseDocumenti" class="accordion-collapse collapse" data-section="documenti" aria-labelledby="headingDocumenti" data-bs-parent="#accordionFascicolo">
                        <div class="accordion-body bg-light">
                            <div class="contenitore-dati text-muted mb-0">Clicca per caricare i dati...</div>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

<!-- Script per la Fetch Dinamica e Media -->
@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const accordion = document.getElementById('accordionFascicolo');
            const dogId = @Model.CurrentDog.Id;

            accordion.addEventListener('show.bs.collapse', async (event) => {
                const panel = event.target;
                const body = panel.querySelector('.contenitore-dati');
                const section = panel.getAttribute('data-section');

                // Evita chiamate ripetute se i dati sono già stati caricati con successo
                if (panel.hasAttribute('data-loaded')) return;

                body.innerHTML = '<div class="text-center text-muted"><i class="spinner-border spinner-border-sm me-2"></i>Caricamento in corso...</div>';
                    try {
                        const response = await fetch(`?handler=DatiFascicolo&id=${dogId}&sezione=${section}`);
    
                        if (response.ok) {
                            // Prende direttamente l'HTML generato dalla Partial View
                            const html = await response.text(); 
                            body.innerHTML = html;
                            panel.setAttribute('data-loaded', 'true');
                        } else {
                            body.innerHTML = '<div class="text-danger">Errore durante il recupero dei dati.</div>';
                        }
                    } catch (error) {
                        body.innerHTML = '<div class="text-danger">Errore di rete.</div>';
                    }
            });
        });
        
        //#region Gestione Imagine
          uploadProfilePhoto = async (dogId, inputElement)=> {
            const file = inputElement.files[0];
            if (!file) return;

            // 1. Controllo del tipo MIME (solo immagini)
            if (!file.type.startsWith('image/')) {
                if (typeof box !== 'undefined' && box.alert) {
                    box.alert('Seleziona un file immagine valido (JPG, PNG, WebP, ecc.).');
                } else {
                    alert('Seleziona un file immagine valido.');
                }
                inputElement.value = '';
                return;
            }

            const imgPreview = document.getElementById(`dogImg_${dogId}`);
            const imgCurrent = document.getElementById(`image-profile-current`);
            const originalSrc = imgPreview.src;

            try {
                // 2. Anteprima locale immediata
                imgPreview.src = URL.createObjectURL(file);
                if (imgCurrent) imgCurrent.src = URL.createObjectURL(file);

                // 3. Ridimensionamento lato client tramite Canvas
                const resizedBlob = await resizeImage(file, 800, 0.85);

                // 4. Preparazione dati FormData
                const formData = new FormData();
                formData.append("dogId", dogId);
                formData.append("photo", resizedBlob, "profile.webp");

                const tokenElement = document.querySelector('input[name="__RequestVerificationToken"]');
                const token = tokenElement ? tokenElement.value : "";

                // AGGIUNGI IL TOKEN ANCHE AL FORMDATA!
                formData.append("__RequestVerificationToken", token);

                // 5. Invio all'handler Razor Pages
                const response = await fetch("/musi/index?handler=UploadPhoto", {
                    method: "POST",
                    headers: {
                        "RequestVerificationToken": token
                    },
                    body: formData
                });

                if (!response.ok) {
                    throw new Error("Errore durante il caricamento");
                }

                const data = await response.json();
                if (data.newUrl) {
                    imgPreview.src = baseUrl + data.newUrl; 
                    if (imgCurrent) imgCurrent.src = baseUrl + data.newUrl; 
                }

            
            } catch (error) {
                if (typeof box !== 'undefined' && box.alert) {
                    box.alert("Si è verificato un errore durante l'aggiornamento della foto.");
                } else {
                    alert("Si è verificato un errore durante l'aggiornamento della foto.");
                }
                imgPreview.src = originalSrc; // Ripristina l'immagine originale in caso di errore
                console.error(error);

            } finally {
                inputElement.value = ""; // Resetta l'input file
            }
        }

        deletePicDog = async (dogId, dogName) =>{
            box.confirm(`Sei sicuro di voler eliminare la foto profilo di ${dogName}?`, async (ok) => {
                if (ok) {
                    const tokenElement = document.querySelector('input[name="__RequestVerificationToken"]');
                    const token = tokenElement ? tokenElement.value : "";
                    const response = await fetch(`/musi/index?handler=DeletePhoto&dogId=${dogId}`);
                    if (response.ok) {
                        document.getElementById(`dogImg_${dogId}`).src = "/images/logo.png";
                        box.hideAll();
                    } else {
                        box.alert('Errore durante l\'eliminazione della foto.');
                    }
                }
            }, "Conferma eliminazione", "confirm-delete");
        }

      openProfileImage = async (dogId) => {
        const loader = "<div id='divImageProfile'><div class='text-center p-4'><i class='spinner-border text-primary me-2'></i>Caricamento immagine...</div></div>";
        box.dialog(loader,'', 'w-90');
          const body=document.getElementById('divImageProfile');
          try {
              const response = await fetch(`?handler=OpenProfileImage&id=${dogId}`);

              if (response.ok) {
                  // Prende direttamente l'HTML generato dalla Partial View
                  const html = await response.text();
                    body.innerHTML=html;
              } else {
                  body.innerHTML = '<div class="text-danger">Errore durante il recupero dei dati.</div>';
              }
          } catch (error) {
              body.innerHTML = '<div class="text-danger">Errore di rete.</div>';
          }
      }
      //#endregion
      
    //#region Gestione Media del Muso
    uploadDogMedia = async (dogId, inputElement) => {
        const file = inputElement.files[0];
        if (!file) return;

        const isVideo = file.type.startsWith('video/');
        const isImage = file.type.startsWith('image/');
    
        if(!isVideo && !isImage) {
            if (typeof box !== 'undefined' && box.alert) {
                    box.alert("Per favore seleziona solo foto o video.");
            } else {
                    alert("Per favore seleziona solo foto o video.");
            }
            inputElement.value = '';
            return;
        }

        // Nasconde l'eventuale messaggio di "nessun media"
        const emptyMsg = document.getElementById('emptyMediaMessage');
        if (emptyMsg) emptyMsg.style.display = 'none';

        // Predisposizione dell'anteprima in pagina
        const gallery = document.getElementById('dogMediaGallery');
        const localUrl = URL.createObjectURL(file);
    
        const colDiv = document.createElement('div');
        colDiv.className = 'col-6 col-md-3';
    
        // Mostra uno spinner di caricamento come overlay
        colDiv.innerHTML = `
            <div class="position-relative rounded-3 overflow-hidden shadow-sm ratio ratio-1x1 border bg-light">
                <div class="position-absolute top-50 start-50 translate-middle text-primary" style="z-index: 10;">
                        <i class="spinner-border"></i>
                </div>
                    ${isImage 
                    ? `<img src="${localUrl}" class="object-fit-cover w-100 h-100 opacity-50" />` 
                    : `<video src="${localUrl}" class="object-fit-cover w-100 h-100 opacity-50"></video>`}
            </div>
        `;
        gallery.prepend(colDiv);

        try {
            const formData = new FormData();
            formData.append("dogId", dogId);
        
            // Se è un'immagine, la ridimensioniamo prima di inviarla per risparmiare spazio e banda
            if (isImage) {
                    const resizedBlob = await resizeImage(file, 1200, 0.85); // Usa la funzione di resize che c'è in site.js
                    formData.append("mediaFile", resizedBlob, file.name || "media.webp");
            } else {
                    formData.append("mediaFile", file);
            }

            const tokenElement = document.querySelector('input[name="__RequestVerificationToken"]');
            const token = tokenElement ? tokenElement.value : "";
            formData.append("__RequestVerificationToken", token);

            const response = await fetch("?handler=UploadMedia", {
                method: "POST",
                headers: {
                    "RequestVerificationToken": token
                },
                body: formData
            });

            if (!response.ok) {
                throw new Error("Errore durante il caricamento");
            }

            const data = await response.json();
        
            if (data.success && data.url) {
                // Aggiorna l'anteprima rimuovendo lo spinner e caricando l'url reale di R2
                const realUrl = "https://media.muzzlebook.it" + data.url;
                colDiv.innerHTML = `
                    <div class="position-relative rounded-3 overflow-hidden shadow-sm ratio ratio-1x1 border bg-dark">
                        ${data.isVideo 
                            ? `<video src="${realUrl}" class="object-fit-contain w-100 h-100" controls></video>` 
                            : `<img src="${realUrl}" class="object-fit-cover w-100 h-100" />`}
                    </div>
                `;
            }
        } catch (error) {
            if (typeof box !== 'undefined' && box.alert) {
                box.alert("Si è verificato un errore durante il caricamento del file.");
            } else {
                alert("Si è verificato un errore durante il caricamento del file.");
            }
            colDiv.remove(); // Rimuove l'anteprima fallita
            console.error(error);
        } finally {
            inputElement.value = ""; // Resetta l'input per permettere nuovi caricamenti
        }
    }
deleteDogMedia = async (mediaId) => {
        box.confirm(`Sei sicuro di voler eliminare questo file?`, async (ok) => {
            if (ok) {
                const tokenElement = document.querySelector('input[name="__RequestVerificationToken"]');
                const token = tokenElement ? tokenElement.value : "";
                
                try {
                    const response = await fetch(`?handler=DeleteMedia&mediaId=${mediaId}`, {
                        method: "POST",
                        headers: {
                            "RequestVerificationToken": token
                        }
                    });

                    if (response.ok) {
                        // Rimuove visivamente l'elemento dalla pagina
                        document.getElementById(`mediaBox_${mediaId}`).remove();
                        box.hideAll();
                        
                        // Opzionale: rimostrare il messaggio vuoto se non ci sono più elementi
                        const gallery = document.getElementById('dogMediaGallery');
                        if (gallery.children.length === 0) {
                            gallery.innerHTML = `
                                <div class="col-12 text-center text-muted py-4" id="emptyMediaMessage">
                                    <i class="bi bi-camera fs-1 d-block mb-2 opacity-50"></i>
                                    Nessuna foto o video. Condividi un momento speciale del tuo muso!
                                </div>`;
                        }
                    } else {
                        box.alert('Errore durante l\'eliminazione del file.');
                    }
                } catch (error) {
                    console.error(error);
                    box.alert('Si è verificato un errore di rete.');
                }
            }
        }, "Conferma eliminazione", "confirm-delete");
    }
    //#endregion
    </script>
}