@page
@model Muzzlebook.Pages.LoginModel
@{
    ViewData["Title"] = "Accedi";
}

<div class="container my-5" style="max-width: 450px;">
    <div class="card shadow">
        <div class="card-body p-4">
            <h3 class="card-title text-center mb-4"><i class="bi bi-person-lock me-2"></i>Accedi</h3>

            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="alert alert-danger">@Model.ErrorMessage</div>
            }

            <!-- Form di Login Standard -->
<form method="post">
    <div class="mb-3">
        <label class="form-label">Email</label>
        <input asp-for="Input.Email" type="email" class="form-control" required />
    </div>
    <div class="mb-3">
        <label class="form-label">Password</label>
        <input asp-for="Input.Password" type="password" class="form-control" required />
    </div>
    
    <!-- 🌟 Nuova Checkbox "Ricordami" -->
    <div class="form-check mb-3">
        <input asp-for="Input.RememberMe" class="form-check-input" type="checkbox" id="rememberMe">
        <label class="form-check-label" for="rememberMe">
            Ricordami su questo dispositivo
        </label>
    </div>

    <button type="submit" class="btn btn-primary w-100 mb-3">Accedi</button>
</form>

            <hr />

            <!-- Pulsante Login Statico (Bypass/Dev) -->
            <form method="post" asp-page-handler="StaticLogin">
                <button type="submit" class="btn btn-outline-secondary w-100">
                    <i class="bi bi-lightning-charge-fill me-1"></i> Login Statico (Demo User)
                </button>
            </form>

            <div class="text-center mt-3">
                <small>Non hai un account? <a asp-page="/Register">Registrati qui</a></small>
            </div>
        </div>
    </div>
</div>